param (
    [Parameter(Mandatory=$true)]
    [string]$Goal,

    [string]$Workspace = ".",

    [string]$Model = "qwen2.5-coder:32b",
    
    [int]$MaxSteps = 10,

    [int]$NumCtx = 32768,

    [int]$EstimatedChangedLinesPerTask = 80,

    [switch]$PreferCloudTokenConservation,

    [switch]$HighRisk,

    [switch]$KeepArtifacts,

    [ValidateSet("auto", "syntax", "syntax_and_command", "command_only", 
"none")]
    [string]$ValidatorProfile = "syntax",

    [string]$ValidationCommand = "",

    [int]$ValidationTimeoutSeconds = 120
)



$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path

# Utility to call Local LLM for Planning
function Get-TaskPlan {
    param([string]$goal, [string]$workspace)
    
    $files = Get-ChildItem -Path $workspace -File -Recurse | Where-Object { 
        $_.FullName -notmatch '\.git' -and $_.FullName -notmatch 'node_modules'
-and $_.FullName -notmatch '\.system_generated' 
    } | Select-Object -ExpandProperty FullName
    
    $fileList = $files -join "`n"
    
    $prompt = @"
You are an Autonomous Agent Planner. 
The user's high-level goal is: $goal

Here are the available files in the workspace:
$fileList

Analyze the goal and break it down into a sequence of atomic file-edit tasks.
Output EXACTLY a JSON array of objects. Do NOT wrap in markdown or backticks.
Schema:
[
  { "Task": "Detailed description of what to change", "TargetFile": "absolute 
or relative path" }
]
"@

    $tmpPromptFile = Join-Path $env:TEMP 
"planner_prompt_$([guid]::NewGuid()).md"
    $tmpOutputFile = Join-Path $env:TEMP 
"planner_output_$([guid]::NewGuid()).md"
    $criticPromptFile = Join-Path $env:TEMP 
"critic_prompt_$([guid]::NewGuid()).md"
    $criticOutputFile = Join-Path $env:TEMP 
"critic_output_$([guid]::NewGuid()).md"

    $plannerPrompt = $prompt
    $finalJson = ""

    for ($turn = 1; $turn -le 2; $turn++) {
        Set-Content -Path $tmpPromptFile -Value $plannerPrompt -Encoding UTF8
        Write-Host "Calling Planner LLM ($Model) (Turn $turn)..." 
-ForegroundColor Cyan
        & "$scriptDir\Invoke-LocalLLM.ps1" -PromptFile $tmpPromptFile 
-OutputFile $tmpOutputFile -TaskTitle "Planner" -Model $Model -SystemPrompt 
"You are a JSON-only Planner. Output only raw JSON array." -NumCtx $NumCtx | 
Out-Null
        
        $response = ""
        if (Test-Path -LiteralPath $tmpOutputFile) {
            $response = Get-Content -Path $tmpOutputFile -Raw -Encoding UTF8
        }

        # Phase 1: Critic Feedback Loop
        Write-Host "Calling Critic LLM to evaluate the plan..." 
-ForegroundColor Magenta
        $criticPrompt = @"
You are a strict Critic. The Planner has generated the following JSON task plan
to achieve this goal:
GOAL: $goal

PLANNER JSON:
$response

Review the plan. Does it miss critical file dependencies? Are there redundant 
steps?
If the plan is good, output EXACTLY: [APPROVED]
If the plan is bad, output your critique explaining why, followed by 
[REJECTED].
"@
        Set-Content -Path $criticPromptFile -Value $criticPrompt -Encoding UTF8
        & "$scriptDir\Invoke-LocalLLM.ps1" -PromptFile $criticPromptFile 
-OutputFile $criticOutputFile -TaskTitle "Critic" -Model $Model -NumCtx $NumCtx
| Out-Null
        
        $criticResponse = ""
        if (Test-Path -LiteralPath $criticOutputFile) {
            $criticResponse = Get-Content -Path $criticOutputFile -Raw 
-Encoding UTF8
        }
        
        if ($criticResponse -match '\[APPROVED\]') {
            Write-Host "Critic approved the plan!" -ForegroundColor Green
            $finalJson = $response
            break
        } else {
            Write-Warning "Critic rejected the plan. Critique: $criticResponse"
            $finalJson = $response # Save as fallback
            $plannerPrompt = "$prompt`n`n=== PREVIOUS DRAFT 
===`n$response`n`n=== CRITIQUE ===`n$criticResponse`nFix the JSON plan based on
the critique."
        }
    }

    Remove-Item -LiteralPath $tmpPromptFile, $tmpOutputFile, $criticPromptFile,
$criticOutputFile -ErrorAction SilentlyContinue
    
    try {
        # Strip markdown if LLM misbehaves
        $json = $finalJson -replace '```json', '' -replace '```', ''
        $tasks = $json | ConvertFrom-Json
        return $tasks
    } catch {
        throw "Failed to parse Planner output as JSON. Output was: $finalJson"
    }
}

Write-Host "========================================" -ForegroundColor Magenta
Write-Host "Starting Autonomous Agentic Loop" -ForegroundColor Magenta
Write-Host "Goal: $Goal" -ForegroundColor Magenta
Write-Host "========================================" -ForegroundColor Magenta

# 1. Plan
$queue = Get-TaskPlan -goal $Goal -workspace $Workspace

if ($null -eq $queue -or $queue.Count -eq 0) {
    Write-Error "Planner returned an empty queue."
    exit 1
}

Write-Host "Planner generated $($queue.Count) tasks:" -ForegroundColor Yellow
$queue | Format-Table | Out-String | Write-Host

# 2. Execution Loop
$stepCount = 0
$ledger = @()

while ($queue.Count -gt 0) {
    $task = $queue[0]
    $queue = $queue | Select-Object -Skip 1
    
    $stepCount++
    if ($stepCount -gt $MaxSteps) {
        Write-Warning "Max steps ($MaxSteps) reached. Aborting autonomous 
loop."
        break
    }
    
    Write-Host "----------------------------------------" -ForegroundColor Cyan
    Write-Host "Executing Task [$stepCount]: $($task.Task)" -ForegroundColor 
Cyan
    Write-Host "Target File: $($task.TargetFile)" -ForegroundColor Cyan
    
    try {
        # Invoke through the delegation bridge so every file-write task gets a
        # recorded policy decision before it reaches the safe editor.
        $delegateArgs = @{
            Prompt                       = $task.Task
            TargetFile                   = $task.TargetFile
            Model                        = $Model
            Files                        = @($task.TargetFile)
            NumCtx                       = $NumCtx
            EstimatedChangedLines        = $EstimatedChangedLinesPerTask
            RequiresFileWrite            = $true
            PreferCloudTokenConservation = 
$PreferCloudTokenConservation.IsPresent
            HighRisk                     = $HighRisk.IsPresent
            KeepArtifacts                = $KeepArtifacts.IsPresent
            ValidatorProfile             = $ValidatorProfile
            ValidationCommand            = $ValidationCommand
            ValidationTimeoutSeconds     = $ValidationTimeoutSeconds
        }
        & "$scriptDir\Invoke-DelegatedAgentTask.ps1" @delegateArgs
        Write-Host "Task $stepCount SUCCESS" -ForegroundColor Green
        
        $ledger += [PSCustomObject]@{
            Step = $stepCount
            Task = $task.Task
            TargetFile = $task.TargetFile
            Status = "Success"
        }
    } catch {
        Write-Error "Task $stepCount FAILED: $_"
        $ledger += [PSCustomObject]@{
            Step = $stepCount
            Task = $task.Task
            TargetFile = $task.TargetFile
            Status = "Failed"
            Error = $_.Exception.Message
        }
        
        Write-Warning "Task failed. Triggering Dynamic Replanning..."
        $replanningGoal = "$Goal`n`n[DYNAMIC REPLANNING] A previous task 
failed: $($_.Exception.Message). Review the current workspace and generate a 
new plan to achieve the goal."
        $newQueue = Get-TaskPlan -goal $replanningGoal -workspace $Workspace
        
        if ($null -ne $newQueue -and $newQueue.Count -gt 0) {
            $queue = $newQueue
            Write-Host "Successfully replanned $($queue.Count) new tasks." 
-ForegroundColor Yellow
        } else {
            Write-Warning "Dynamic Replanning failed to generate new tasks. 
Halting."
            break
        }
    }
}

Write-Host "========================================" -ForegroundColor Magenta
Write-Host "Autonomous Loop Completed" -ForegroundColor Magenta
Write-Host "========================================" -ForegroundColor Magenta

Write-Host "Ledger Summary:" -ForegroundColor Yellow
$ledger | Format-Table | Out-String | Write-Host
