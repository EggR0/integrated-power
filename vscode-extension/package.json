{
  "name": "antigravity-ide-dashboard",
  "publisher": "integratedpower",
  "displayName": "Antigravity IDE Dashboard",
  "description": "Dashboard for tracking AI agent runs and token usage",
  "version": "0.3.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:integratedPower.agentRunsDashboard",
    "onCommand:integratedPower.eggr.installOrUpdateHarness"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Integrated Power",
      "properties": {
        "integratedPower.view.showAntigravity": {
          "type": "boolean",
          "default": true,
          "description": "Show the Antigravity IDE capacity section in the dashboard."
        },
        "integratedPower.view.showCodex": {
          "type": "boolean",
          "default": true,
          "description": "Show the Codex capacity section in the dashboard."
        },
        "integratedPower.view.showLocalLlm": {
          "type": "boolean",
          "default": true,
          "description": "Show the Local LLM capacity section in the dashboard."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "integratedPower",
          "title": "Integrated Power",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "integratedPower": [
        {
          "type": "webview",
          "id": "integratedPower.agentRunsDashboard",
          "name": "Agent Runs Dashboard",
          "icon": "$(dashboard)"
        }
      ]
    },
    "commands": [
      {
        "command": "integratedPower.agentRuns.refresh",
        "title": "Refresh Agent Runs Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "integratedPower.agentRuns.openRunsFile",
        "title": "Open Runs JSONL File",
        "icon": "$(json)"
      },
      {
        "command": "integratedPower.agentRuns.configureViews",
        "title": "Antigravity IDE: Configure Dashboard Views"
      },
      {
        "command": "integratedPower.eggr.installOrUpdateHarness",
        "title": "EggR: Install or Update Antigravity Harness"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "integratedPower.agentRuns.refresh",
          "when": "view == integratedPower.agentRunsDashboard",
          "group": "navigation"
        },
        {
          "command": "integratedPower.agentRuns.openRunsFile",
          "when": "view == integratedPower.agentRunsDashboard",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./scripts/build-extension.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "pnpm run compile && node ./scripts/run-headless-tests.js",
    "test:extension": "pnpm run compile && node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.0.0",
    "glob": "^13.0.6",
    "esbuild": "^0.28.1",
    "mocha": "^11.7.6",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
